# ══════════════════════════════════════════════════════════════════════════════
#  TYRANT//BOT — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit your .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Solana / pump.fun ──────────────────────────────────────────────────────────
# Solana RPC endpoint — use a private RPC for speed (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet private key (base58 string OR JSON byte array "[1,2,...,64]").
# Can also be pasted from the dashboard (writes here). REQUIRED when DRY_RUN=false.
SOLANA_PRIVATE_KEY=

# SOL amount to spend as initial buy when each token launches
PUMPFUN_INITIAL_BUY_SOL=0.0001

# Dev buy: purchased atomically with the create tx, then sold after the delay below.
DEV_BUY_SOL=0.1
DEV_SELL_DELAY_SECONDS=5

# Priority fee in SOL (helps transactions land faster)
PUMPFUN_PRIORITY_FEE=0.0005

# Slippage tolerance in percent
PUMPFUN_SLIPPAGE=5

# ── Jito (atomic create + dev-buy bundle) ─────────────────────────────────────
# In live mode the create tx and buy tx ship as a Jito bundle so they land in
# the same block atomically. Tip lamports go to one of Jito's tip accounts.
JITO_BUNDLE_URL=https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=10000

# ── Launch Control ─────────────────────────────────────────────────────────────
# !! Set DRY_RUN=false only when ready to spend real SOL !!
# DRY_RUN=true  → nothing touches Solana (skips IPFS upload, tx build, sign).
DRY_RUN=true

# SIMULATE=true (with DRY_RUN=false) runs the full deploy path but submits
# simulateTransaction instead of sendTransaction. No SOL spent, no on-chain state.
# Use this to validate the real pump.fun / RPC / signing flow before going live.
SIMULATE=false

# Failed launches retry on the next cycle. Give up after this many FAILED
# attempts on the same meme so a permanently-broken one doesn't block the queue.
MAX_LAUNCH_RETRIES=3

# How many newest entries pull from each KYM category to seed the queue at startup.
STARTUP_SEED_PER_CATEGORY=3

# ── IPFS (Pinata) ──────────────────────────────────────────────────────────────
# REQUIRED for live/simulate launches. Pump.fun's old IPFS endpoint is dead.
# Sign up free at https://pinata.cloud → API Keys → New Key (Pinning scope) → JWT
PINATA_JWT=
# Strongly recommended: dedicated Pinata gateway (Pinata → Gateways → copy the
# subdomain). Public ipfs.io can take a minute to propagate fresh CIDs and
# pumpportal will 400 the URI as unreachable. Example:
# PINATA_GATEWAY=turquoise-immediate-lobster-357.mypinata.cloud
PINATA_GATEWAY=

# ── KnowYourMeme Scraping ──────────────────────────────────────────────────────
# Only confirmed + submission feed the launch queue. Newsworthy/deadpool are noise.
# How many entries to pull per category each scan
KYM_MAX_ENTRIES_PER_CATEGORY=100

# ── Timing ─────────────────────────────────────────────────────────────────────
# How often to scrape KYM and add new memes to the launch queue (seconds)
SCAN_INTERVAL_SECONDS=300

# Minimum gap between consecutive launches (seconds). Even if the queue holds
# 10 memes, the launcher fires one every LAUNCH_INTERVAL_SECONDS. Empty queue =
# no launch (it just waits). Default is 5 minutes.
LAUNCH_INTERVAL_SECONDS=300

# Dashboard UI refresh rate (seconds)
DASHBOARD_REFRESH_SECONDS=2.0

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=tyrant_launches.db

# ── OpenRouter (AI naming / description / quality gate) ──────────────────────
# Get a key at https://openrouter.ai/keys. With the key empty, the AI steps
# silently no-op and the bot falls back to algorithmic name + raw KYM description.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-task model selection. Defaults: cheap creative (Haiku) for naming/desc,
# cheap vision (Gemini Flash) for the quality gate. Any OpenRouter slug works.
OPENROUTER_MODEL_NAMING=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_DESCRIPTION=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_QUALITY=google/gemini-2.5-flash

# Toggle each AI step. Quality gate is OFF by default — KYM is curated already.
NAMING_ENABLED=true
DESCRIPTION_ENABLED=true
QUALITY_GATE_ENABLED=false

# Optional analytics tags shown on the OpenRouter dashboard.
OPENROUTER_REFERER=https://github.com/tyrant-bot
OPENROUTER_TITLE=TYRANT//BOT

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO