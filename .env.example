# ══════════════════════════════════════════════════════════════════════════════
#  TYRANT//BOT — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit your .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Solana / pump.fun ──────────────────────────────────────────────────────────
# No private key needed — wallet signing is done in the browser via Phantom/Solflare.

# Solana RPC endpoint — use a private RPC for speed (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# SOL amount to spend as initial buy when each token launches
PUMPFUN_INITIAL_BUY_SOL=0.0001

# Priority fee in SOL (helps transactions land faster)
PUMPFUN_PRIORITY_FEE=0.0005

# Slippage tolerance in percent
PUMPFUN_SLIPPAGE=10

# ── Launch Control ─────────────────────────────────────────────────────────────
# !! Set DRY_RUN=false only when ready to spend real SOL !!
# In dry-run mode, launches are simulated but no transaction is submitted.
DRY_RUN=true

# Max tokens to launch per scan cycle
MAX_LAUNCHES_PER_CYCLE=3

# ── KnowYourMeme Scraping ──────────────────────────────────────────────────────
# How many entries to pull per category (confirmed/submission/newsworthy/deadpool)
KYM_MAX_ENTRIES_PER_CATEGORY=10

# ── Timing ─────────────────────────────────────────────────────────────────────
# How often to scrape KYM and launch new coins (seconds)
SCAN_INTERVAL_SECONDS=300

# Dashboard UI refresh rate (seconds)
DASHBOARD_REFRESH_SECONDS=2.0

# ── Telegram Alerts (optional) ─────────────────────────────────────────────────
# Create a bot via @BotFather to get the token
TELEGRAM_BOT_TOKEN=

# Your chat ID (send /start to @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=tyrant_launches.db

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
